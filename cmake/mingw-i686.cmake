# 32-bit Windows (the game is PE32) with llvm-mingw, from the Mac.
# tools/fetch_toolchain.sh unpacks it into build/toolchains.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR i686)
file(GLOB _llvm_mingw "${CMAKE_CURRENT_LIST_DIR}/../build/toolchains/llvm-mingw-*")
if(DEFINED ENV{LLVM_MINGW})
  set(_llvm_mingw "$ENV{LLVM_MINGW}")
endif()
if(NOT _llvm_mingw)
  message(FATAL_ERROR "llvm-mingw not found: run tools/fetch_toolchain.sh or set LLVM_MINGW")
endif()
list(GET _llvm_mingw 0 _llvm_mingw)
set(CMAKE_C_COMPILER "${_llvm_mingw}/bin/i686-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${_llvm_mingw}/bin/i686-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${_llvm_mingw}/bin/i686-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${_llvm_mingw}/i686-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
